# Copy to `.env` and fill in. Every value below is read at runtime on the
# server; none of them are exposed to the browser.

# --- Application -----------------------------------------------------------

# Public origin of this app. Used to build the Auth0 redirect URI, so it must
# match the callback URL registered in Auth0 exactly.
BASE_URL=http://localhost:3000

# Base URL of the backend API. A path prefix is preserved, so both
# `https://api.example.com` and `https://api.example.com/api` work.
BACKEND_URL=http://localhost:5000

# Endpoint told about each successful sign-in, so the backend can create or
# update its own user record. The path differs per backend:
#
#   iluma.base-api-python  ->  /api/auth/login
#   .NET backend           ->  /User/login
#
# Leave empty to skip the sync entirely — the app then needs no backend to log
# in. The request body is `{ token, email, name }`, a superset both accept.
BACKEND_LOGIN_PATH=

# Signs the session cookie. Generate with `openssl rand -base64 32`.
#
# REQUIRED in production — the app refuses to boot without it. A known signing
# key lets anyone mint a validly-signed cookie naming a session id of their
# choosing. Outside production an insecure built-in default is used so the
# template runs with no setup.
SESSION_SECRET=

# --- Auth0: application ----------------------------------------------------

# Auth0 tenant domain, e.g. `tenant.eu.auth0.com`.
AUTH0_DOMAIN=

AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Identifier of the Auth0 API this app requests tokens for. Required: without
# it Auth0 returns an opaque access token that the backend cannot validate.
AUTH0_AUDIENCE=

# --- Auth0: Management API -------------------------------------------------
# Machine-to-machine credentials used to read each user's permissions at login.
#
# If these are wrong, the permissions lookup fails silently: the error is
# swallowed, the user ends up with zero permissions, and login bounces to
# `/login?error=forbidden` as though the account had no access granted.

AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=

# Only permissions starting with this prefix are kept, scoping the Auth0
# catalog to this application. Empty means "keep all of them".
PERMISSIONS_PREFIX=

# --- Logging ---------------------------------------------------------------

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
